<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/pushRocket"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Rocket"
            android:src="@drawable/rocket_right"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Push ZIP contents to GitHub over SSH (real git push). First: generate an SSH key and add the public key to GitHub Settings → SSH keys."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/generateKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate SSH key"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/publicKeyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(public key will appear here)"
            android:textSize="12sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/copyKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy public key"
            android:enabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/exportBackupButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export backup" />

            <Button
                android:id="@+id/importBackupButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Import backup" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Owner (username/org)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ownerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Repo name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/repoInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Branch (default: main)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/branchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="main" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Commit message">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload project zip from Android" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/pickZipButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick ZIP file"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/selectedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(no file selected)"
            android:textSize="12sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/pushButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Git push (SSH)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/copyLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy log" />

            <Button
                android:id="@+id/viewHistoryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="View history" />
        </LinearLayout>

        <Button
            android:id="@+id/openGithubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open on GitHub" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:paddingTop="12dp" />

    </LinearLayout>
</ScrollView>
